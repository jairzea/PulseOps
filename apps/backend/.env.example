# Server
PORT=3000
NODE_ENV=development

# MongoDB
MONGODB_URI=mongodb://localhost:27017/pulseops

# JWT Authentication
JWT_SECRET=pulseops-secret-key-change-in-production
JWT_EXPIRES_IN=24h

# Authentication (legacy - can be removed)
AUTH_MODE=demo

# Auth0 (future)
# AUTH0_DOMAIN=your-domain.auth0.com
# AUTH0_AUDIENCE=https://api.pulseops.local

# SMTP (Fase 3 — notificación por correo). Si SMTP_HOST está vacío, el envío
# falla con error claro pero la app sigue funcionando. Migración futura a Workspace.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM="PulseOps <no-reply@pulseops.local>"

# Integración con repositorios (GitHub).
#
# Modo recomendado (producción): GitHub App. Identidad del PRODUCTO (no cambia por cliente).
# Registra una App en GitHub, instálala en la org y pon aquí su ID + private key (PEM).
# El GITHUB_APP_SLUG es el nombre en la URL de instalación (github.com/apps/<slug>).
# Las instalaciones (installationId) se guardan en DB al conectar desde la UI — sin secretos.
GITHUB_APP_ID=
GITHUB_APP_SLUG=
# La PEM puede ir en una línea con \n escapados.
GITHUB_APP_PRIVATE_KEY=

# Modo bootstrap / pruebas (Nivel 0): Personal Access Token de SOLO LECTURA
# (scopes: contents, metadata, pull requests). Sirve para validar el motor contra repos
# personales sin registrar una App. GITHUB_ORG vacío = repos del usuario del token.
# Si hay App configurada, esta tiene prioridad sobre el PAT.
GITHUB_TOKEN=
GITHUB_ORG=

# Sincronización programada. REPO_SYNC_ENABLED=true la activa (default off → solo a demanda).
# Default: miércoles (DOW=3) a las 18:00 GMT-5.
REPO_SYNC_ENABLED=false
REPO_SYNC_DOW=3
REPO_SYNC_HOUR=18
