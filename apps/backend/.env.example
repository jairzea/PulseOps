# Server
PORT=3000
NODE_ENV=development

# MongoDB
MONGODB_URI=mongodb://localhost:27017/pulseops

# JWT Authentication
JWT_SECRET=pulseops-secret-key-change-in-production
JWT_EXPIRES_IN=24h

# Authentication (legacy - can be removed)
AUTH_MODE=demo

# Auth0 (future)
# AUTH0_DOMAIN=your-domain.auth0.com
# AUTH0_AUDIENCE=https://api.pulseops.local

# SMTP (Fase 3 — notificación por correo). Si SMTP_HOST está vacío, el envío
# falla con error claro pero la app sigue funcionando. Migración futura a Workspace.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM="PulseOps <no-reply@pulseops.local>"

